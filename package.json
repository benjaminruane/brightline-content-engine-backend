{
  "name": "brightline-content-engine-backend",
  "version": "dev",
  "private": true,
  "type": "module",
  "packageManager": "npm@10",
  "engines": {
    "node": "22.x"
  },
  "main": "api/generate.js",
  "scripts": {
    "test": "vitest run",
    "qc:test": "node scripts/run_qc_regression.mjs",
    "r1_2:build-eval-inputs": "node tests/r1_2_mini_eval/build_inputs.mjs",
    "r1_2:mini-eval": "node tests/r1_2_mini_eval/run_eval.mjs",
    "r1_2:score": "node tests/r1_2_mini_eval/run_eval.mjs --score-only",
    "r1_2:2": "node tests/r1_2_mini_eval/run_r1_2_2.mjs",
    "r1_2:2-report": "node tests/r1_2_mini_eval/run_r1_2_2.mjs --report-only",
    "audit:inits": "node tools/audit-statement-analysis-inits.mjs --out init-audit.json",
    "qc:diag:prep": "node scripts/diagnostic/prep-extract.mjs",
    "qc:diag:run": "node scripts/diagnostic/run-batch.mjs",
    "diagnostic:style-guide": "node scripts/diagnostic/run-style-guide.mjs",
    "mvp:summary": "node scripts/regen-mvp-summary.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/db/migrate.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.93.0",
    "@mozilla/readability": "^0.5.0",
    "@neondatabase/serverless": "^1.1.0",
    "docx": "^9.6.1",
    "jsdom": "^24.0.0",
    "langfuse": "^3.38.20",
    "node-fetch": "2.6.12",
    "officeparser": "^7.5.1",
    "openai": "^4.0.0",
    "pdfkit": "^0.18.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "acorn": "^8.15.0",
    "csv-parse": "^6.2.1",
    "vitest": "^3.2.4"
  }
}
